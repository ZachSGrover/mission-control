# MSA — Environment variables.
# Copy this file to ".env" in the same directory and fill in real values.
# .env is gitignored. Never commit real keys.

# AdsPower local API key (find it in AdsPower app → Settings → API).
ADSPOWER_API_KEY=

# Anthropic API key for the /analyze content-strategy endpoint.
ANTHROPIC_API_KEY=

# Notion integration token for the revenue dashboard sync.
# Create via https://www.notion.so/profile/integrations and share both
# revenue + payments DBs with the integration.
NOTION_API_KEY=

# Optional: override Notion database IDs (defaults are baked into notion_sync.py).
# NOTION_DB_REVENUE=
# NOTION_DB_PAYMENTS=

# ── Safety guards ─────────────────────────────────────────────
# DRY_RUN=true means bots simulate but never click/send/post on X.
# Set to false ONLY when you actually want live action.
DRY_RUN=true

# Belt-and-suspenders: live external actions also require this flag.
# Bots refuse to run live unless BOTH DRY_RUN=false AND
# ALLOW_LIVE_EXTERNAL_ACTIONS=true are set.
ALLOW_LIVE_EXTERNAL_ACTIONS=false

# TEST_MODE=true tells the guard and bots to log everything verbosely.
# Has no effect on whether live actions happen — that is gated by the two
# flags above. Safe to leave on.
TEST_MODE=true

# Hard cap on live actions in a single bot run. 1 means the bot can do
# exactly one DM/repost/scrape and must stop. 0 means unlimited (default
# bot behaviour). Honoured by safety_guard.record_action_or_exit().
MAX_TEST_ACTIONS=1

# Third gate for live mode. Must equal the literal string YES (uppercase)
# before the guard will allow live execution. Stays unset by default so
# accidental DRY_RUN=false + ALLOW_LIVE_EXTERNAL_ACTIONS=true can't go live.
# Set CONFIRM_LIVE_TEST=YES only at the moment you intend to run one live
# action, and unset it immediately afterwards.
CONFIRM_LIVE_TEST=
