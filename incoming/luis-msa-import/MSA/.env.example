# MSA — Environment variables.
# Copy this file to ".env" in the same directory and fill in real values.
# .env is gitignored. Never commit real keys.

# AdsPower local API key (find it in AdsPower app → Settings → API).
ADSPOWER_API_KEY=

# Anthropic API key for the /analyze content-strategy endpoint.
ANTHROPIC_API_KEY=

# Notion integration token for the revenue dashboard sync.
# Create via https://www.notion.so/profile/integrations and share both
# revenue + payments DBs with the integration.
NOTION_API_KEY=

# Optional: override Notion database IDs (defaults are baked into notion_sync.py).
# NOTION_DB_REVENUE=
# NOTION_DB_PAYMENTS=

# ── Safety guards ─────────────────────────────────────────────
# DRY_RUN=true means bots simulate but never click/send/post on X.
# Set to false ONLY when you actually want live action.
DRY_RUN=true

# Belt-and-suspenders: live external actions also require this flag.
# Bots refuse to run live unless BOTH DRY_RUN=false AND
# ALLOW_LIVE_EXTERNAL_ACTIONS=true are set.
ALLOW_LIVE_EXTERNAL_ACTIONS=false
