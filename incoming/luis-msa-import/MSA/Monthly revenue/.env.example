# Notion Integration Token für Revenue Dashboard Sync
#
# Setup (einmalig):
#  1. https://www.notion.so/profile/integrations öffnen
#  2. "+ New integration" → Name z.B. "Revenue Dashboard Sync" → Type: Internal → Submit
#  3. Internal Integration Secret kopieren (beginnt mit "ntn_..." oder "secret_...")
#  4. In Notion zu MODEL REVENUE DB → "..." → Connections → deine Integration → Confirm
#  5. Schritt 4 für PAYMENTS DB wiederholen
#  6. Diese Datei kopieren zu ".env" (ohne ".example") und Token unten eintragen
#  7. server.py neu starten

NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database-IDs (Default: deine MODEL REVENUE + PAYMENTS DBs)
NOTION_DB_REVENUE=2ecc4ce4962e8071b5e6f463df259ad1
NOTION_DB_PAYMENTS=2edc4ce4962e80a6b09ad0ed9ab3ba40
